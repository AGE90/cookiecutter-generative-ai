{
  "project_name": "My Project",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "module_name": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') }}",
  "project_description": "A one-line summary of the project",
  "author_name": "Your name",
  "author_email": "you@example.com",
  "project_version": "0.1.0",
  "project_url": "https://example.com",
  "python_version": "3.12",
  "license": ["MIT", "Apache-2.0", "BSD-3-Clause", "GPL-3.0-or-later", "No license file"],
  "llm_provider": ["anthropic", "openai", "ollama"],
  "initialize_env": ["yes", "no"],
  "project_dependencies": "langchain, langgraph, fastapi, uvicorn[standard], python-dotenv, pyprojroot",
  "extra_dependencies": "",
  "development_dependencies": "mypy, ruff, pre-commit, ipykernel",
  "testing_dependencies": "pytest, pytest-cov, httpx",
  "initialize_git_repository": ["yes", "no"],
  "_llm_packages": {
    "anthropic": "langchain-anthropic",
    "openai": "langchain-openai",
    "ollama": "langchain-ollama"
  },
  "_default_models": {
    "anthropic": "anthropic:claude-opus-5",
    "openai": "openai:gpt-5",
    "ollama": "ollama:llama3.2"
  },
  "_api_key_vars": {
    "anthropic": "ANTHROPIC_API_KEY",
    "openai": "OPENAI_API_KEY",
    "ollama": ""
  }
}
