# Copy to .env (done for you on project creation) and fill in. .env is git-ignored.

# Model as "<provider>:<model>" (see LangChain's init_chat_model)
LLM_MODEL={{ cookiecutter._default_models[cookiecutter.llm_provider] }}
{%- if cookiecutter._api_key_vars[cookiecutter.llm_provider] %}

{{ cookiecutter._api_key_vars[cookiecutter.llm_provider] }}=
{%- else %}

# Ollama runs locally: install it, then `ollama pull {{ cookiecutter._default_models[cookiecutter.llm_provider].split(":")[1] }}`
{%- endif %}
